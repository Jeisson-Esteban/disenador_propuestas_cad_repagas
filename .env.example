# ============================================================================
# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena.
#
# El backend lee estas variables al arrancar. NUNCA commitees tu `.env`
# real — esta en .gitignore por defecto.
# ============================================================================

# ─── Base de datos (PostgreSQL + pgvector) ─────────────────────────────────
# Para arrancar local: crear DB con `createdb kitchen_demo`, activar pgvector
# y cargar el schema demo (`psql kitchen_demo < demo_assets/schema.sql`).

SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=kitchen_demo
SUPABASE_URL=

# ─── Gemini API (Google AI Studio) ─────────────────────────────────────────
# Necesaria para:
#   - El motor de propuesta (generador_cocinas.py llama a Gemini Pro)
#   - Los embeddings del RAG (rag_pipeline.py usa gemini-embedding-001)
#
# Obten una key en https://aistudio.google.com/app/apikey

GEMINI_API_KEY_LLM=
GEMINI_API_KEY=

# Rotacion opcional para evitar limites del tier gratuito de Gemini.
# Si tienes varias keys, anadelas aqui y el sistema las usa en round-robin.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ─── OpenRouter (fallback opcional) ────────────────────────────────────────
# Si Gemini falla o se agotan los limites, el sistema cae a OpenRouter.
# Es opcional — deja vacio si no lo necesitas.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro-preview

# ─── Autenticacion del panel admin ─────────────────────────────────────────
# Sistema de auth SIMPLE — pensado como ejemplo, no production-grade.
# Ver seccion "Autenticacion" del README para extenderlo (JWT, OAuth, etc.).
APP_LOGIN_USER=admin
APP_LOGIN_PASS=changeme

# ─── Rutas locales (opcional) ──────────────────────────────────────────────
# Solo si tienes una carpeta de referencia adicional (ej. catalogos PDF que
# quieres indexar via /admin/rag/upload).
DATA_ROOT=./datos_referencia
